# Senha do painel
DASHBOARD_PASSWORD=troca-por-uma-senha-forte
# String aleatória longa (assina o cookie de login)
AUTH_SECRET=troca-por-uma-string-aleatoria-longa
# Protege o cron. A Vercel envia este valor sozinha.
CRON_SECRET=troca-por-outra-string-aleatoria

# IA que escreve os roteiros
# Gratuito: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Armazenamento: Upstash Redis (Vercel Marketplace). A Vercel preenche sozinha.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-mail diário (Resend)
RESEND_API_KEY=
EMAIL_TO=
EMAIL_FROM=The Daily Byte <onboarding@resend.dev>

# Fuso e hora da entrega
DIGEST_TZ=Europe/Dublin
DIGEST_HOUR=21

# URL do painel (usada no e-mail). Opcional na Vercel.
DASHBOARD_URL=
